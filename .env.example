# 锅炸扑克 - 环境变量配置示例
# 复制此文件为 .env 并填入你的配置

# ===== TTS 语音服务配置 =====

# MeLo TTS 服务器地址（可选，默认使用内置服务器）
# VITE_MELO_TTS_URL=http://your-melo-server:7860

# Azure Speech Service 配置（可选）
# VITE_AZURE_SPEECH_KEY=your-azure-speech-key
# VITE_AZURE_SPEECH_REGION=eastus

# ===== LLM 服务配置 =====

# OpenAI API Key（可选，用于 AI 聊天功能）
# VITE_OPENAI_API_KEY=sk-your-openai-api-key

# ===== 开发配置 =====

# 服务器端口（默认 3000）
# VITE_PORT=3000

# 是否启用调试模式
# VITE_DEBUG=false
